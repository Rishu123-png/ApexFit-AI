# ─────────────────────────────────────────────────────────────────────────────
# ApexFit AI — environment variables
# Copy to `.env.local` for development. Configure the same names in Vercel
# Project → Settings → Environment Variables for deployment.
# NEVER commit real values. Keys with the NEXT_PUBLIC_ prefix are visible to
# the browser bundle — only Firebase web config (public by design) belongs there.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase web app config (safe to expose — protected by Auth + Security Rules)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Set to "true" ONLY after Google sign-in is enabled in Firebase Console →
# Authentication → Sign-in method. The button is hidden otherwise.
GOOGLE_SIGN_IN_ENABLED=true

# ── Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never commit) ────────

# Firebase Admin SDK (service account) — used to verify ID tokens in API routes
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste with literal \n line breaks escaped, e.g. "-----BEGIN PRIVATE KEY-----\n...\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# Groq AI — used ONLY in server-side API routes. Primary key + fallback key.
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_SECONDARY=

# Optional: override the Groq model id
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Apex Core intelligence (Task 3) ─────────────────────────────────────────
# Enable the real food-photo analysis route (POST /api/ai/food-scan). Without
# this the route answers 503 VISION_NOT_CONFIGURED and the UI stays in its
# honest "unavailable" state. Requires Groq keys above.
GROQ_VISION_ENABLED=false
# Vision model id on Groq (multimodal). Default: llama-4-scout.
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# On-device pose engine (camera coach). Defaults point to public CDNs; set to
# self-hosted URLs to keep the whole supply chain first-party. Never contains
# secrets — these are public asset URLs only.
NEXT_PUBLIC_POSE_WASM_URL=
NEXT_PUBLIC_POSE_MODEL_URL=
