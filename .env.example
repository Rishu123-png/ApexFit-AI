# ─────────────────────────────────────────────────────────────────────────────
# ApexFit AI — environment variables
# Copy to `.env.local` for development. Configure the same names in Vercel
# Project → Settings → Environment Variables for deployment.
# NEVER commit real values. Keys with the NEXT_PUBLIC_ prefix are visible to
# the browser bundle — only Firebase web config (public by design) belongs there.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase web app config (safe to expose — protected by Auth + Security Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" ONLY after Google sign-in is enabled in Firebase Console →
# Authentication → Sign-in method. The button is hidden otherwise.
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# ── Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never commit) ────────

# Firebase Admin SDK (service account) — used to verify ID tokens in API routes
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste with literal \n line breaks escaped, e.g. "-----BEGIN PRIVATE KEY-----\n...\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# Groq AI — used ONLY in server-side API routes. Primary key + fallback key.
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_SECONDARY=

# Optional: override the Groq model id
# GROQ_MODEL=llama-3.3-70b-versatile
